# Copy this file to .env for local runs, or set these in the Render dashboard.
# NEVER commit the real .env file.

# Server (Render injects PORT automatically; 8080 locally)
PORT=8080

# Comma-separated list of browser origins allowed to call this API.
# Local dev:      http://localhost:5173
# Production:     https://your-site.vercel.app
FRONTEND_ORIGINS=http://localhost:5173

# --- AI assistant (optional) ---
# Create a free key at https://aistudio.google.com/apikey .
# Leave blank to keep the frontend's built-in keyword fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Contact form (optional) ---
# Render's free tier blocks outbound SMTP (ports 25/465/587), so production
# uses Brevo's HTTPS API. Create a free key at https://app.brevo.com/settings/keys/api
# and verify the sender address under Senders & IPs first.
BREVO_API_KEY=
# Verified Brevo sender address (also used as the SMTP From when only SMTP is set)
CONTACT_FROM=
# Inbox that receives contact messages
CONTACT_TO=
# Optional SMTP fallback (works locally and on paid hosts that allow SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
