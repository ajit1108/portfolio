# Copy this file to .env for local runs, or set these in the Render dashboard.
# NEVER commit the real .env file.

# Server (Render injects PORT automatically; 8080 locally)
PORT=8080

# Comma-separated list of browser origins allowed to call this API.
# Local dev:      http://localhost:5173
# Production:     https://your-site.vercel.app
FRONTEND_ORIGINS=http://localhost:5173

# --- AI assistant (optional) ---
# Create a free key at https://aistudio.google.com/apikey .
# Leave blank to keep the frontend's built-in keyword fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Contact form (optional) ---
# Any SMTP provider works. For Gmail you must use an App Password, not your
# account password: https://myaccount.google.com/apppasswords
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
CONTACT_TO=
